# Supabase Configuration (Public - used in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Configuration (Secret - server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay Configuration
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
# Required for webhook signature verification (Razorpay Dashboard > Webhooks)
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# WhatsApp Configuration
NEXT_PUBLIC_WHATSAPP_BUSINESS_PHONE_NUMBER_ID=your-phone-number-id
NEXT_PUBLIC_WHATSAPP_BUSINESS_ACCOUNT_ID=your-account-id
WHATSAPP_BUSINESS_API_TOKEN=your-api-token

# Analytics (Optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_CLARITY_ID=your-clarity-id

# Google AdSense (public pages only — never dashboard)
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-2707130870413244
# Create ad units in AdSense → Ads → By ad unit, then paste slot IDs:
# NEXT_PUBLIC_ADSENSE_SLOT_TOOL_TOP=
# NEXT_PUBLIC_ADSENSE_SLOT_TOOL_BOTTOM=
# NEXT_PUBLIC_ADSENSE_SLOT_BLOG_TOP=
# NEXT_PUBLIC_ADSENSE_SLOT_BLOG_BOTTOM=
# NEXT_PUBLIC_ADSENSE_SLOT_BLOG_INDEX=
# ads.txt must contain: google.com, pub-2707130870413244, DIRECT, f08c47fec0942fa0


# Other Configuration
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Cron (optional): set CRON_SECRET and add to Vercel Cron; used by /api/cron/archive
# CRON_SECRET=your-random-secret
